{
  // The starter packages (packages/*/) as a config folder runs them: TypeScript taken
  // as-is by Node, importing only "teobeanie" (and "teobeanie/test" in their specs).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "paths": {
      "teobeanie": ["./src/toolkit.ts"],
      "teobeanie/test": ["./test/teobeanie-test.ts"]
    }
  },
  "include": ["packages/**/*.ts"]
}
