{
  "name": "teobeanie",
  "version": "0.8.2",
  "private": true,
  "description": "Behaviours for Home Assistant as tested pure functions, with a journal of every decision, built with your own AI agent over MCP",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.packages.json",
    "test": "vitest run",
    "build:panel": "pnpm --filter teobeanie-panel build",
    "build:all": "pnpm run build && pnpm run build:panel",
    "house-types": "node dist/studio/cli.js types"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@lambda-house/teob-ts": "^0.4.2",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.9.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
