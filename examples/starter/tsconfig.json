{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "paths": {
      "teobeanie": [
        "./.teob/toolkit.d.ts"
      ],
      "teob": [
        "./.teob/toolkit.d.ts"
      ]
    }
  },
  "include": [
    "heuristics/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "heuristics/**/*.test.ts",
    "packages/**/*.test.ts"
  ]
}
