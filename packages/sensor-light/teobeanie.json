{
  "name": "sensor-light",
  "version": "1.0.0",
  "platform": ">=0.2.0 <1.0.0",
  "title": "Sensor light",
  "description": "Lights on when a sensor sees someone, off once the room has been quiet; people win in between.",
  "pattern": "trigger",
  "heuristics": {
    "sensor-light": {
      "title": "Sensor → lights",
      "pattern": "trigger",
      "roles": {
        "sensors": {
          "domain": "binary_sensor",
          "device_class": ["occupancy", "motion", "presence"],
          "many": true,
          "doc": "Presence or motion sensors: any of them active switches the lights on."
        },
        "lights": {
          "domain": ["light", "switch"],
          "many": true,
          "operate": true,
          "doc": "light.* and switch.* entities."
        },
        "dark.illuminance": {
          "domain": "sensor",
          "device_class": "illuminance",
          "optional": true
        },
        "dark.tooBright": {
          "domain": "binary_sensor",
          "device_class": "light",
          "optional": true
        },
        "keepOnWhile.entities": {
          "domain": ["binary_sensor", "input_boolean", "media_player", "switch"],
          "many": true,
          "optional": true
        }
      },
      "uses": ["clock", "sun"]
    }
  }
}
